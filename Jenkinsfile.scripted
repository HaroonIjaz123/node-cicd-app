properties([
  pipelineTriggers([pollSCM('H/2 * * * *')]),
  disableConcurrentBuilds(),
  buildDiscarder(logRotator(numToKeepStr: '10')),
  parameters([
    booleanParam(name: 'DEPLOY', defaultValue: true,
      description: 'Publish to the local lab preview')
  ])
])

node {
  timeout(time: 10, unit: 'MINUTES') {
    withEnv(['LAB_DEPLOY_ROOT=/opt/jenkins-lab/node-cicd']) {
      try {
        stage('Checkout') { checkout scm }
        stage('Install') { sh 'npm ci' }
        stage('Test') { sh 'npm test' }
        stage('Build') { sh 'npm run build' }
        stage('Archive') {
          archiveArtifacts artifacts: 'dist/**', fingerprint: true
        }
        stage('Deploy') {
          if (params.DEPLOY != false) {
            sh 'npm run deploy -- scripted'
          } else {
            echo 'Deployment skipped by parameter'
          }
        }
        echo 'CI passed. Check the Deploy stage for publication.'
      } catch (err) {
        echo 'Failed. Inspect Console Output before retrying.'
        throw err
      } finally {
        echo "Finished build ${env.BUILD_NUMBER}"
      }
    }
  }
}
